# 复制本文件为 server/.env 并按需修改。所有变量都有默认值，可不设。

# 后端监听端口
PORT=3000

# LLM 上游初始默认值：前端保存后由 server/llm-config.local.json 覆盖
# ollama（本地）或 openai（兼容接口）
LLM_PROVIDER=ollama
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=llama3.2

# 仅 LLM_PROVIDER=openai 时需要
LLM_API_KEY=

# 默认生成参数（前端可覆盖）
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.8

# 默认只记录最多 300 字的提示词/回复预览。设为 true 才记录完整正文。
LLM_LOG_CONTENT=false
