:: PassageHeader
<<silently>>
  /* Register default scene images as resources for ThemeEngine */
  <<script>>
    if (typeof ThemeEngine !== 'undefined') {
      ThemeEngine.registerResource('Bedroom', PixelImage.generate('Bedroom', 160, 120));
      ThemeEngine.registerResource('Street', PixelImage.generate('Street', 160, 120));
      ThemeEngine.registerResource('Park', PixelImage.generate('Park', 160, 120));
      ThemeEngine.registerResource('Shop', PixelImage.generate('Shop', 160, 120));
    }

    /* Ensure LLM state variables exist (important when loading older saves). */
    if (typeof State !== 'undefined' && State.variables) {
      if (!State.variables.llmConfig) {
        State.variables.llmConfig = {
          enabled: true,
          provider: 'ollama',
          endpoint: 'http://localhost:11434',
          model: 'llama3.2',
          apiKey: '',
          maxTokens: 512,
          temperature: 0.8
        };
      }
      if (!State.variables.llmHistory) {
        State.variables.llmHistory = [];
      }
      if (!State.variables.llmSession) {
        State.variables.llmSession = {
          active: false,
          sceneContext: '',
          lastResponse: ''
        };
      }
      if (!State.variables.generatedScenes) {
        State.variables.generatedScenes = {};
      }
      if (typeof State.variables.dynamicSceneId === 'undefined') {
        State.variables.dynamicSceneId = '';
      }
      if (!State.variables.npcs) {
        State.variables.npcs = {};
      }
      if (!State.variables.quests) {
        State.variables.quests = {};
      }
      if (!State.variables.worldMemory) {
        State.variables.worldMemory = { events: [] };
      }
      if (typeof State.variables.activeNPCId === 'undefined') {
        State.variables.activeNPCId = '';
      }
      if (typeof State.variables.activeQuestId === 'undefined') {
        State.variables.activeQuestId = '';
      }
      if (typeof State.variables.llmGatewayTarget === 'undefined') {
        State.variables.llmGatewayTarget = '';
      }

      // Playability patch: ensure new $game fields exist in older saves.
      if (State.variables.game) {
        if (typeof State.variables.game.tutorialComplete === 'undefined') State.variables.game.tutorialComplete = false;
        if (typeof State.variables.game.over === 'undefined') State.variables.game.over = false;
        if (typeof State.variables.game.overReason === 'undefined') State.variables.game.overReason = '';
        if (typeof State.variables.game.rentDueDay === 'undefined') State.variables.game.rentDueDay = 7;
        if (typeof State.variables.game.rentAmount === 'undefined') State.variables.game.rentAmount = 50;
        if (typeof State.variables.game.rentPaid === 'undefined') State.variables.game.rentPaid = false;
        if (typeof State.variables.game.evicted === 'undefined') State.variables.game.evicted = false;
      }

      // Skill system compat: initialize skills on older saves.
      if (State.variables.player && !State.variables.player.skills) {
        State.variables.player.skills = {
          运动: { value: 0, xp: 0 },
          学识: { value: 0, xp: 0 },
          社交: { value: 0, xp: 0 },
          潜行: { value: 0, xp: 0 },
          感知: { value: 0, xp: 0 },
          意志: { value: 0, xp: 0 },
          魅力: { value: 0, xp: 0 }
        };
      }
      // Item catalog placeholder for future consumable system.
      if (!State.variables.itemCatalog) {
        State.variables.itemCatalog = {
          '能量饮料': { type: 'consumable', effects: { stamina: 30, stress: 5 }, desc: '恢复大量体力，但略微增加压力' },
          '零食': { type: 'consumable', effects: { hunger: -20, health: 5 }, desc: '小零食，缓解饥饿' },
          '止痛药': { type: 'consumable', effects: { health: 20, stress: -5 }, desc: '恢复健康，放松心情' }
        };
      }
    }
  <</script>>
<</silently>>
