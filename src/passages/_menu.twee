      passage: passage(),
      dynamicSceneId: passage() is "DynamicScene" ? $dynamicSceneId : "",
      activeNPCId: passage() is "NPCChat" ? $activeNPCId : ""
    }>>
  <</if>>
  <<goto "QuestLog">>
<</link>>
