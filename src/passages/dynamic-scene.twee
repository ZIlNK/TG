:: DynamicScene
<<set _scene to $generatedScenes[$dynamicSceneId]>>

<<if _scene>>
  <div class="scene-shell scene-shell-dynamic">
  <header class="scene-header">
    <h1 class="scene-title"><<llmtext _scene.title>></h1>
    <div class="scene-location"><<llmtext `(typeof RegionSystem !== "undefined" ? RegionSystem.formatPosition() : _scene.location)`>></div>
  </header>

  <div class="scene-media"><<sceneimg _scene.location>></div>

  <div class="scene-narrative"><<llmtext _scene.text>></div>

  <div class="dynamic-options"><<sceneoptions>></div>
  <div class="page-actions"><<action "返回" "back" "回到原处">></div>
  </div>
<<else>>
  !场景不可用

  找不到请求的动态场景。它可能是在另一个存档中生成的，或者场景 ID 缺失。

  <div class="page-actions"><<action "返回" "back" "回到原处">></div>
<</if>>

:: AreaScene
<<set _region to (typeof RegionSystem !== "undefined" ? RegionSystem.currentRegion() : null)>>
<<set _area to (typeof RegionSystem !== "undefined" ? RegionSystem.currentArea() : null)>>

<<if _region and _area and _area.id neq _region.defaultAreaId>>
  <div class="scene-shell scene-shell-area">
    <header class="scene-header">
      <h1 class="scene-title"><<llmtext _area.name>></h1>
      <div class="scene-location"><<llmtext `RegionSystem.formatPosition()`>></div>
    </header>

    <div class="scene-media"><<sceneimg `RegionSystem.formatPosition()`>></div>

    <<hubscene _region.id "neutral" _area.description>>

    <div class="scene-fixed-actions">
      <<link `"返回" + _region.name`>>
        <<run MoveTool.invoke({ locationId: _region.id, areaId: _region.defaultAreaId }, { source: "area-return" })>>
      <</link>>
    </div>
  </div>
<<elseif _region>>
  <<goto _region.passage>>
<<else>>
  !区域不可用

  当前子区域没有完成注册。

  <div class="page-actions"><<action "返回" "back" "回到原处">></div>
<</if>>

:: LLMGateway
<<silently>>
  <<set _target to $llmGatewayTarget>>
  <<set _parts to _target.split(":")>>
  <<set _type to _parts[1]>>
  <<set _seed to _parts[2] || "">>
<</silently>>

<<if _type is "generate">>
  <<set _sceneDef = {
    location: $location,
    mood: "neutral",
    description: _seed
  }>>
  <div class="scene-shell scene-shell-loading">
    <header class="scene-header">
      <h1 class="scene-title">正在生成场景</h1>
      <div class="scene-location"><<llmtext `(typeof RegionSystem !== "undefined" ? RegionSystem.formatPosition() : $location)`>></div>
    </header>
    <<llmscene2 _sceneDef.location _sceneDef.mood _sceneDef.description>>
  </div>
<<else>>
  未知的 LLM 网关目标：<<llmtext _target>>

  <<action "返回" "DynamicScene">>
<</if>>


:: QuestEvent
<div class="scene-shell">
<<questevent>>
</div>

:: SceneAction
<div class="scene-shell">
<<sceneaction>>
</div>
