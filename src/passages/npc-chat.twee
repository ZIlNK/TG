:: NPCChat
!与 <<print $npcs[$activeNPCId].name>> 交谈

<<set _npc to $npcs[$activeNPCId]>>

你正在和 <<print _npc.name>> 交谈，TA 是 <<print _npc.role>>。

<<if _npc.relationship>>
  <<set _relTier to getRelationshipTier(_npc)>>
  <<set _relValue to _npc.relationship.value || 0>>
  <<set _relProgress to Math.round(getRelationshipProgress(_npc) * 100)>>
  <div class="npc-relationship-badge">
    <span class="npc-rel-tier">[<<print _relTier>>]</span>
    <div class="stat-bar" style="margin: 4px 0;">
      <div class="stat-bar-label"><span>关系</span><span><<print _relValue>>/100</span></div>
      <div class="stat-bar-track"><div class="stat-bar-fill stat-relationship" @style="'width: ' + _relProgress + '%;'"></div></div>
    </div>
  </div>
<</if>>

<<npcchat $activeNPCId>>

<<if (_npc.disposition || 0) gte -5>>
  <<action "请求任务" "RequestQuest" "看看 TA 是否需要帮助">>
  <<action "提交任务" "TurnInQuest" "交还已完成的任务">>
<<else>>
  <p>对方看起来不太愿意和你交谈。</p>
<</if>>
<<action "结束对话" $location "回到原处">>

:: MeetNPC
!偶遇

<<sceneimg $location>>

你在<<print $location>>留意起周围的人。

<<llmnpc "" "路人" $location>>

<<action "不打招呼，离开" $location "回到原处">>

:: RequestQuest
!请求任务

<<if $activeNPCId neq "">>
  <<set _npc to $npcs[$activeNPCId]>>
  <<if (_npc.disposition || 0) gte -5>>
    <<llmquest $activeNPCId "一个本地的、只有玩家能解决的问题">>
  <<else>>
    <p><<print _npc.name>> 冷冷地看了你一眼，似乎不想给你任务。</p>
  <</if>>
<<else>>
  附近没有可以交谈的人。

  <<action "去找个人" "MeetNPC" "遇见此地的某个人">>
<</if>>

<<action "返回对话" "NPCChat">>
<<action "离开" $location "回到原处">>

:: TurnInQuest
!提交任务

<<if $activeQuestId and $quests[$activeQuestId] and $quests[$activeQuestId].status is "active">>
  <<set _q to $quests[$activeQuestId]>>
  <<set _allDone to true>>
  <<for _obj range _q.objectives>>
    <<if not _obj.completed>><<set _allDone to false>><</if>>
  <</for>>
  <<if _allDone>>
    <<set _msgs to applyQuestRewards(_q)>>
    任务完成！<<print _q.title>>
    <<if _msgs.length gt 0>><p>获得奖励：<<print _msgs.join("、")>></p><</if>>
  <<else>>
    任务还没完成。继续努力吧。
  <</if>>
<<else>>
  你没有可提交的任务。
<</if>>

<<action "返回" "NPCChat">>
