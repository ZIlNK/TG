:: NPCChat
<<nobr>>
<<set _npc to $npcs[$activeNPCId]>>
<<if not _npc>>
  <<set $activeNPCId to "">>
  <div class="llm-error-banner">对话对象不存在或已失效，无法进入对话。</div>
  <<action "返回当前场景" $location "返回所在地点">>
<<else>>
<div class="npc-chat-page">
  <header class="npc-chat-header">
    <h1 class="npc-chat-title">与 <<llmtext _npc.name>> 交谈</h1>
    <p class="npc-chat-intro">你正在和 <<llmtext _npc.name>> 交谈，TA 是 <<llmtext _npc.role>>。</p>
    <<if _npc.relationship>>
      <<set _relTier to getRelationshipTier(_npc)>>
      <<set _relValue to _npc.relationship.value || 0>>
      <<set _relProgress to Math.round(getRelationshipProgress(_npc) * 100)>>
      <div class="npc-relationship-badge">
        <span class="npc-rel-tier" id="npc-rel-tier">[<<print _relTier>>]</span>
        <div class="stat-bar">
          <div class="stat-bar-label"><span>关系</span><span id="npc-rel-value"><<print _relValue>>/100</span></div>
          <div class="stat-bar-track"><div class="stat-bar-fill stat-relationship" id="npc-rel-fill" @style="'width: ' + _relProgress + '%;'"></div></div>
        </div>
      </div>
    <</if>>
  </header>

  <<npcchat $activeNPCId>>

  <div class="npc-chat-actions">
    <<if (_npc.disposition || 0) gte -5>>
      <<action "请求任务" "RequestQuest" "看看 TA 是否需要帮助">>
      <<questturnins $activeNPCId>>
      <<action "查看可交付任务" "TurnInQuest" "检查可以交给这位 NPC 的任务">>
    <<else>>
      <p>对方看起来不太愿意和你交谈。</p>
    <</if>>
    <<enddialogue>>
  </div>
</div>
<</if>>
<</nobr>>

:: MeetNPC
!偶遇

<<sceneimg $location>>

你在<<print $location>>留意起周围的人。

<<llmnpc "" "路人" $location>>

<<action "不打招呼，离开" $location "回到原处">>

:: RequestQuest
!请求任务

<<if $activeNPCId neq "" and $npcs[$activeNPCId]>>
  <<set _npc to $npcs[$activeNPCId]>>
  <<if (_npc.disposition || 0) gte -5>>
    <<llmquest $activeNPCId "一个本地的、只有玩家能解决的问题">>
  <<else>>
    <p><<llmtext _npc.name>> 冷冷地看了你一眼，似乎不想给你任务。</p>
  <</if>>
<<else>>
  附近没有可以交谈的人。

  <<action "去找个人" "MeetNPC" "遇见此地的某个人">>
<</if>>

<<action "返回对话" "NPCChat">>
<<action "离开" $location "回到原处">>

:: TurnInQuest
!提交任务

<<set _ready to (typeof TaskEngine !== "undefined") ? TaskEngine.readyForNPC($activeNPCId) : []>>
<<if _ready.length>>
  <<for _q range _ready>>
    <<set _qid to _q.id>><<capture _qid>>
      <div class="llm-quest-card">
        <h3><<llmtext _q.title>></h3>
        <p><<llmtext _q.description>></p>
        <<link "交付任务">><<set _result to TaskEngine.turnIn(_qid, {npcId: $activeNPCId})>><<if _result.ok>><<goto "NPCChat">><<else>><span class="llm-error-banner"><<llmtext _result.error>></span><</if>><</link>>
      </div>
    <</capture>>
  <</for>>
<<else>>
  你没有可以交给这位 NPC 的任务。
<</if>>

<<action "返回" "NPCChat">>
